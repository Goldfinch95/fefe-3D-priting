# Copiá este archivo como .env para trabajar en tu computadora (no lo subas a Git)

# Supabase → botón Connect → "Transaction pooler" (puerto 6543). Reemplazá [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API (para el tiempo real; son datos públicos)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Opcional: si lo definís, el sitio pide usuario y contraseña
# APP_USER=fefe
# APP_PASSWORD=
