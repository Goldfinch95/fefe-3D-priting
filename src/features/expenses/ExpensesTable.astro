---
// Tabla de gastos: estructura (título, buscador, botón, tabla y modal)
import { meta, columns } from "./expenses.data";
import ExpenseModal from "./ExpenseModal.astro";
import "./expenses.css";
---

<section class="expenses" id="expenses" data-singular={meta.singular} data-plural={meta.plural}>
  <header class="expenses__head">
    <h1>{meta.title}</h1>
    <p>{meta.description}</p>
  </header>

  <!-- Barra superior: buscador, contador y botón para añadir -->
  <div class="expenses__bar">
    <div class="expenses__search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <input id="expenses-q" type="search" placeholder={meta.searchLabel} aria-label={meta.searchLabel} />
    </div>
    <div class="expenses__actions">
      <span class="expenses__count" id="expenses-count" aria-live="polite"></span>
      <button type="button" class="btn" data-expense-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        {meta.add}
      </button>
    </div>
  </div>

  <!-- Los roles mantienen la semántica de tabla cuando el CSS la convierte en tarjetas -->
  <div class="expenses__box">
    <table class="expenses__table" role="table">
      <caption class="expenses__sr">
        {meta.title} con {columns.supplier.toLowerCase()}, {columns.date.toLowerCase()}, {columns.quantity.toLowerCase()}, {columns.amount.toLowerCase()} y {columns.notes.toLowerCase()}
      </caption>
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col"><button class="expenses__sort" data-col="0" data-type="text">{columns.description}</button></th>
          <th role="columnheader" scope="col"><button class="expenses__sort" data-col="1" data-type="text">{columns.supplier}</button></th>
          <th role="columnheader" scope="col"><button class="expenses__sort" data-col="2" data-type="number">{columns.date}</button></th>
          <th role="columnheader" scope="col" class="expenses__num"><button class="expenses__sort" data-col="3" data-type="number">{columns.quantity}</button></th>
          <th role="columnheader" scope="col" class="expenses__num"><button class="expenses__sort" data-col="4" data-type="number">{columns.amount}</button></th>
          <th role="columnheader" scope="col">{columns.notes}</th>
          <th role="columnheader" scope="col" class="expenses__edit"><span class="expenses__sr">Editar</span></th>
        </tr>
      </thead>
      <!-- Las filas las arma expenses.client.ts (datos de ejemplo + guardados) -->
      <tbody role="rowgroup"></tbody>
    </table>
    <p class="expenses__empty" id="expenses-empty" hidden></p>
  </div>

  <ExpenseModal />
</section>

<!-- Astro empaqueta este script y lo carga una sola vez -->
<script>
  import { initExpenses } from "./expenses.client";
  initExpenses();
</script>